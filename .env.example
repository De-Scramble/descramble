# De-Scramble configuration — copy to `.env` and edit as needed.
#
# Every value here has a working default, so the pipeline runs with no
# configuration at all. Nothing in this file is a credential, and De-Scramble
# never needs one to run locally.

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
# Path to the records to resolve. CSV and Parquet are both accepted; the format
# is chosen from the file extension.
DESCRAMBLE_INPUT=data/sample_records.csv

# ---------------------------------------------------------------------------
# Lakehouse output (local by default — no cloud account required)
# ---------------------------------------------------------------------------
# Directory holding the Iceberg warehouse and its SQLite catalogue.
DESCRAMBLE_WAREHOUSE=warehouse

# Catalogue, namespace and table that golden records are written to.
DESCRAMBLE_CATALOG=descramble
DESCRAMBLE_NAMESPACE=descramble
DESCRAMBLE_TABLE=golden_records

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------
# Two records are treated as the same person at or above this match
# probability. Raise it to merge less (fewer false merges, more duplicates
# left behind); lower it to merge more (the opposite trade).
DESCRAMBLE_THRESHOLD=0.9

# Seed for the sampling used during parameter estimation. Fixing it is what
# makes a run reproducible; the same input then yields the same golden records.
DESCRAMBLE_SEED=1729

# ---------------------------------------------------------------------------
# Using a remote catalogue instead of the local one
# ---------------------------------------------------------------------------
# The local SQLite catalogue is a convenience for getting started, not a
# limitation. To point at object storage, set the warehouse to a bucket URI and
# supply a catalogue URI appropriate to your catalogue implementation, e.g.
#
#   DESCRAMBLE_WAREHOUSE=s3://your-bucket/warehouse
#
# Credentials for a remote catalogue are read by PyIceberg from your normal
# environment or cloud configuration. Do not put them in this file, and do not
# commit them.
